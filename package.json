{
  "name": "culture-context",
  "private": true,
  "version": "0.1.0",
  "description": "Provenance-first travel context for mobile and web.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @culture-context/web",
    "dev:admin": "npm run dev --workspace @culture-context/admin",
    "dev:mobile": "npm run start --workspace @culture-context/mobile",
    "dev:api": "bash -c 'cd services/api && PYTHONPATH=. python3 -m uvicorn culture_context.api:app --host ${CULTURE_API_HOST:-127.0.0.1} --port ${CULTURE_API_PORT:-8580} --reload'",
    "ingest:govuk": "bash -c 'cd services/ingestion && PYTHONPATH=. python3 -m culture_ingestion.run'",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:ts": "npm run test --workspaces --if-present",
    "test:py": "PYTHONPATH=services/api:services/ingestion:services/worker python3 -m pytest --import-mode=importlib services/api/tests services/ingestion/tests services/worker/tests",
    "test": "npm run test:ts && npm run test:py",
    "lint": "npm run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
